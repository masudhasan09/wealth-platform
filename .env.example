# Database — the Prisma schema currently declares `provider = "sqlite"`.
# Option A: SQLite (local dev, zero dependencies — matches the schema)
DATABASE_URL="file:./dev.db"
# Option B: PostgreSQL (requires changing schema.prisma to provider = "postgresql"
# and running `docker-compose up -d` first)
# DATABASE_URL="postgresql://wealth:wealth_dev@localhost:5432/wealth_platform"

# Postgres credentials (used by docker-compose.yml)
POSTGRES_USER=wealth
POSTGRES_PASSWORD=wealth_dev
POSTGRES_DB=wealth_platform
POSTGRES_PORT=5432

# Auth.js
AUTH_SECRET="replace-with-openssl-rand-base64-32-output"
AUTH_URL="http://localhost:3000"

# App Encryption Key (Required: 32-byte hex for AES-256-GCM secret encryption)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY="replace-with-32-byte-hex-string"

# Admin User Email
ADMIN_EMAIL="admin@wealthtrack.dev"

# Market data providers (added in later phases)
# FINNHUB_API_KEY=""
# TWELVE_DATA_API_KEY=""
# COINGECKO_API_KEY=""
# FRED_API_KEY=""

# App
NEXT_PUBLIC_APP_NAME="WealthTrack"
NEXT_PUBLIC_DISCLAIMER="For informational purposes only. Not financial or tax advice."
NODE_ENV=development
